<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StudentPortalConsole</RootNamespace>
  </PropertyGroup>

  <!--
    Carried forward from Session 14, same three packages, same version —
    this project is day-ready (Rule 39), nobody installs packages today.
