@model StudentPortalWeb.Models.Student

<h2>Edit Student</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="YearOfStudy"></label>
        <input asp-for="YearOfStudy" class="form-control" />
        <span asp-validation-for="YearOfStudy" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Gpa"></label>
        <input asp-for="Gpa" class="form-control" />
        <span asp-validation-for="Gpa" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>